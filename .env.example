# Application identity.
WEBUI_NAME=Lambda WebUI

# Network listener and public URL. HOST=0.0.0.0 permits LAN connections.
HOST=0.0.0.0
PORT=8080
WEBUI_URL=http://localhost:8080
# LAN example: WEBUI_URL=http://192.168.1.50:8080

# Authentication and multi-user registration. On an existing installation,
# signup is persisted in the database and may also need to be enabled from
# Admin Panel -> Settings -> General. New users remain pending until approved.
WEBUI_AUTH=true
ENABLE_LOGIN_FORM=true
ENABLE_SIGNUP=true
ENABLE_SIGNUP_PASSWORD_CONFIRMATION=true
DEFAULT_USER_ROLE=pending

# Allow every approved user to use all provider-discovered models. The upstream
# Workspace model-management UI was removed from this fork, so leave this true
# for a multi-user deployment unless model access is enforced another way.
BYPASS_MODEL_ACCESS_CONTROL=true

# start.sh creates and reuses a secret-key file automatically. If another
# launcher is used, set a stable random WEBUI_SECRET_KEY; changing it logs out
# existing sessions and can affect encrypted configuration.
# WEBUI_SECRET_KEY=

# Enable these only when WEBUI_URL is HTTPS.
WEBUI_SESSION_COOKIE_SECURE=false
WEBUI_AUTH_COOKIE_SECURE=false

# Ollama URL used by the Open WebUI backend. Remote browsers use Open WebUI's
# proxy and do not need direct access to Ollama. If a LAN URL is used, Ollama
# must separately listen there (for example OLLAMA_HOST=0.0.0.0:11434 in the
# Ollama service environment).
OLLAMA_BASE_URL='http://127.0.0.1:11434'
# LAN Ollama example: OLLAMA_BASE_URL='http://192.168.1.50:11434'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# Low-latency local speech recognition defaults.
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
# Remove this setting to enable automatic language detection.
WHISPER_LANGUAGE=en

# Preload Kokoro.js in each browser after login. The model is cached by the browser.
ENABLE_KOKORO_PRELOAD=false
KOKORO_PRELOAD_DTYPE=q8
KOKORO_DEFAULT_VOICE=bf_emma
# Use auto to prefer WebGPU when available, or wasm to skip GPU probing.
KOKORO_DEVICE=auto

# Force an OpenAI-compatible local TTS service for every user. When Open WebUI
# runs on the host, use 127.0.0.1; from Compose, use http://kokoro-tts:8880/v1.
FORCE_AUDIO_TTS_CONFIG=false
AUDIO_TTS_ENGINE=openai
AUDIO_TTS_OPENAI_API_BASE_URL=http://127.0.0.1:8880/v1
AUDIO_TTS_OPENAI_API_KEY=not-needed
AUDIO_TTS_MODEL=kokoro
AUDIO_TTS_VOICE=bf_emma
AUDIO_TTS_OPENAI_PARAMS='{"response_format":"mp3","speed":1.0}'

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# FastAPI serves the production frontend and API on one origin, so CORS is
# mainly needed for the separate Vite development frontend. Separate origins
# with semicolons and list only origins that should call the API.
CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
# LAN example:
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080;http://192.168.1.50:5173;http://192.168.1.50:8080'

# Set to false to keep memory tools enabled without adding memory context to the system context.
ENABLE_MEMORY_SYSTEM_CONTEXT=true

# Set to false to disable workspace Tools and Functions.
ENABLE_PLUGINS=true

# Disable upstream release checks for installations that carry local changes.
# This suppresses update notifications and avoids presenting an upstream
# release as a safe in-place upgrade for a customized deployment.
ENABLE_VERSION_UPDATE_CHECK=false

# Managed local MCP runtime. Keep the runtime on loopback; browsers connect
# through Open WebUI. Generate a long random token and use the same value (or
# token file) for the backend and runtime processes.
# Native Calendar and Notes settings are intentionally absent: both features
# were removed from this fork. Calendar tools come only from the separately
# registered Local Calendar package under examples/managed-mcp/calendar-tools.
MANAGED_MCP_RUNTIME_URL=http://127.0.0.1:9090
# MANAGED_MCP_RUNTIME_TOKEN=
# MANAGED_MCP_RUNTIME_TOKEN_FILE=/home/user/.config/open-webui/mcp-runtime.token
MANAGED_MCP_RUNTIME_HOST=127.0.0.1
MANAGED_MCP_RUNTIME_PORT=9090
MANAGED_MCP_PACKAGE_ROOTS=/home/user/open-webui/examples/managed-mcp
# MANAGED_MCP_REGISTRY_PATH=/home/user/open-webui/backend/data/managed-mcp/registry.json
# MANAGED_MCP_PRIVILEGE_POLICY_FILE=/etc/open-webui/managed-mcp-privileges.json
# Only a deliberately root-owned runtime service may enable this. When it is
# enabled, confined children are dropped to the specified numeric UID/GID.
MANAGED_MCP_ALLOW_ROOT_RUNTIME=false
# MANAGED_MCP_UNPRIVILEGED_UID=1000
# MANAGED_MCP_UNPRIVILEGED_GID=1000

# Trust forwarded headers only from the local reverse proxy by default.
FORWARDED_ALLOW_IPS='127.0.0.1'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Valkey Vector Store (requires VECTOR_DB=valkey)
# VALKEY_URL='valkey://localhost:6379'
# VALKEY_COLLECTION_PREFIX='open_webui'
# VALKEY_INDEX_TYPE='HNSW'
# VALKEY_DISTANCE_METRIC='COSINE'
# VALKEY_HNSW_M='16'
# VALKEY_HNSW_EF_CONSTRUCTION='200'
# VALKEY_HNSW_EF_RUNTIME='10'

ENABLE_BEDROCK=false
AWS_REGION=us-east-1
# Prefer an IAM role or another AWS credential provider in production. For a
# local credential set, uncomment both values and AWS_SESSION_TOKEN when used.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Comma-separated foundation-model ID prefixes allowed through the Converse API.
# BEDROCK_CONVERSE_MODEL_PREFIXES=ai21.jamba-,amazon.nova-,anthropic.claude-,cohere.command-,deepseek.,google.gemma-,meta.llama,minimax.,mistral.,moonshot.,nvidia.,openai.,qwen.,writer.palmyra-,xai.grok-,zai.glm-
