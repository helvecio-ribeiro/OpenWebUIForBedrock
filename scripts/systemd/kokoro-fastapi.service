[Unit]
Description=Local Kokoro FastAPI text-to-speech service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/kokoro-fastapi
Environment=USE_GPU=false
Environment=PYTHONPATH=%h/.local/share/kokoro-fastapi:%h/.local/share/kokoro-fastapi/api
Environment=MODEL_DIR=src/models
Environment=VOICES_DIR=src/voices/v1_0
Environment=WEB_PLAYER_PATH=%h/.local/share/kokoro-fastapi/web
ExecStart=%h/.local/bin/uv run --no-sync uvicorn api.src.main:app --host 127.0.0.1 --port 8880
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
